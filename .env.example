DATABASE_URL=postgresql://postgres:postgres@localhost:5432/somos_r_dev
# dev | staging | prod. En staging/prod la app NO arranca con un SECRET_KEY corto o de ejemplo.
APP_ENV=dev
# En producción: mínimo 32 caracteres aleatorios. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
# Vida del access token. Recomendado 15 cuando el cliente ya renueva con POST /auth/refresh.
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_DAYS=30

# Producción (Supabase) — dejar comentado en dev
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_KEY=eyJhbGci...

# Redis Local (Opcional - para eventos en desarrollo)
# REDIS_URL=redis://localhost:6379

# Email — "console" (log, default) | "resend"
EMAIL_BACKEND=console
# EMAIL_API_KEY=re_xxx            # Resend API key (never commit a real one)
# EMAIL_FROM=Somos R <no-reply@tu-dominio.com>   # dominio verificado en Resend
FRONTEND_URL=http://localhost:5173

# Rate limiting (por IP). En producción con varios workers usa Redis para compartir contadores.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379
# RATE_LIMIT_LOGIN=10/minute
# RATE_LIMIT_REGISTER=10/minute
# RATE_LIMIT_FORGOT_PASSWORD=5/minute
# RATE_LIMIT_TOKEN_FLOWS=10/minute
# Bloqueo de cuenta: fallos consecutivos antes de bloquear, y tope del bloqueo en minutos
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCK_MAX_MINUTES=60

# Pool de conexiones a la base (por proceso). Conexiones totales = workers x (SIZE + MAX_OVERFLOW):
# mantenerlo por debajo del límite de la base o del pooler (Supabase).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800

# --- HTTP (ver docs/despliegue.md) ---
# Orígenes del frontend permitidos por CORS (separados por comas)
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Hosts que acepta la API (separados por comas). "*" = cualquiera; fijarlo en staging/prod
# ALLOWED_HOSTS=*
# Swagger/ReDoc/openapi.json: por defecto solo en APP_ENV=dev
# ENABLE_DOCS=false

# --- docker-compose (solo desarrollo; se leen del archivo `.env`, no de `.env.local`) ---
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=somos_r_dev
# PGADMIN_EMAIL=admin@somosr.com
# PGADMIN_PASSWORD=admin
