DATABASE_URL=postgresql://postgres:postgres@localhost:5432/somos_r_dev
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Producción (Supabase) — dejar comentado en dev
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_KEY=eyJhbGci...

# Redis Local (Opcional - para eventos en desarrollo)
# REDIS_URL=redis://localhost:6379

# Email — "console" (log, default) | "resend"
EMAIL_BACKEND=console
# EMAIL_API_KEY=re_xxx            # Resend API key (never commit a real one)
# EMAIL_FROM=Somos R <no-reply@tu-dominio.com>   # dominio verificado en Resend
FRONTEND_URL=http://localhost:5173

# Rate limiting (por IP). En producción con varios workers usa Redis para compartir contadores.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379
# RATE_LIMIT_LOGIN=10/minute
# RATE_LIMIT_REGISTER=10/minute
# RATE_LIMIT_FORGOT_PASSWORD=5/minute
# RATE_LIMIT_TOKEN_FLOWS=10/minute
# Bloqueo de cuenta: fallos consecutivos antes de bloquear, y tope del bloqueo en minutos
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCK_MAX_MINUTES=60
