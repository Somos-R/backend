# ─── Stage 1: build dependencies ─────────────────────────────────────────────
FROM python:3.11-slim AS builder
WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN pip install "poetry>=2.0.0,<3.0.0"

COPY pyproject.toml poetry.lock ./
RUN poetry config virtualenvs.in-project true && \
    poetry install --only=main --no-root --no-interaction

# ─── Stage 2: runtime ─────────────────────────────────────────────────────────
FROM python:3.11-slim
WORKDIR /app

# WEB_CONCURRENCY : uvicorn worker processes (each opens its own DB pool; see DB_POOL_SIZE)
# PORT            : port to listen on (Railway and most platforms inject it)
# FORWARDED_ALLOW_IPS : proxies whose X-Forwarded-* headers are trusted, which is what makes the
#                   per-IP rate limit see the real client. "*" is right only when the app is
#                   reachable exclusively through the platform's proxy; otherwise list its IPs.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH" \
    WEB_CONCURRENCY=2 \
    PORT=8000 \
    FORWARDED_ALLOW_IPS="*" \
    PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus

# The running app never installs anything, so pip/setuptools/wheel are only attack surface (and the
# source of most base-image CVEs). Remove them from the system Python; the venv's own pip is removed below.
RUN pip uninstall -y pip setuptools wheel

# The base image can lag behind Debian's security fixes: pull the patched OpenSSL packages (Trivy fails the build
# on HIGH CVEs that already have a fix). --only-upgrade never installs anything that is not already there.
RUN apt-get update && \
    apt-get install -y --no-install-recommends --only-upgrade openssl libssl3t64 openssl-provider-legacy && \
    rm -rf /var/lib/apt/lists/*

# Run as an unprivileged user: a compromised process must not own the filesystem or be root.
RUN useradd --system --uid 10001 --user-group --no-create-home --shell /usr/sbin/nologin app

RUN mkdir -p /tmp/prometheus && chown app:app /tmp/prometheus
COPY --from=builder --chown=app:app /app/.venv ./.venv
RUN rm -rf ./.venv/lib/python3.11/site-packages/pip ./.venv/lib/python3.11/site-packages/pip-*
COPY --chown=app:app . .

USER app
EXPOSE 8000

# /health/live never touches the database, so a slow DB does not get the container killed.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import os, urllib.request; urllib.request.urlopen('http://127.0.0.1:%s/health/live' % os.environ.get('PORT', '8000'), timeout=4)"

# Shell form only to expand the variables; `exec` makes uvicorn PID 1 so it receives SIGTERM.
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT} --workers ${WEB_CONCURRENCY} --proxy-headers --forwarded-allow-ips \"${FORWARDED_ALLOW_IPS}\""]
